[input_devices]

pointing/emulate_mouse_from_touch=false

[internationalization]

locale/translations=PackedStringArray("res://resources/i18n/strings.en.translation", "res://resources/i18n/strings.zh_CN.translation")
locale/fallback="zh_CN"

[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Player"
3d_physics/layer_3="Enemies"
3d_physics/layer_4="Cover"

[physics]

3d/physics_engine="Jolt Physics"
3d/default_gravity=24.0
common/physics_interpolation=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.04, 0.065, 0.09, 1)
